{
  "expo": {
    "name": "PawReminder",
    "slug": "pawreminder",
    "version": "1.0.0",
    "description": "Recordatorios de tratamientos y cuidados preventivos para mascotas.",
    "icon": "./paw-reminder-icon.png",
    "splash": {
      "image": "./paw-reminder.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5FF"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pawreminder",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a PawReminder acceder a tus fotos para elegir una imagen de tu mascota."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.felipemvrin.pawreminder",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "es"
        ]
      }
    },
    "android": {
      "package": "com.felipemvrin.pawreminder",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60e7d3b3-2463-44a8-b2b1-d1ceac41721a"
      }
    },
    "owner": "felipemarin"
  }
}
