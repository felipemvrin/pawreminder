{
  "expo": {
    "name": "PawReminder",
    "slug": "pawreminder",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "pawreminder",
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": { "typedRoutes": true },
    "ios": {
      "supportsTablet": true,
      "infoPlist": { "CFBundleLocalizations": ["es"] }
    },
    "android": { "package": "com.felipemvrin.pawreminder" },
    "web": { "bundler": "metro", "output": "static" }
  }
}
