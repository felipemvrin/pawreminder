# URL base para futuras APIs externas.
EXPO_PUBLIC_API_URL=

# Configuracion publica del cliente de Google Calendar. No incluir secretos aqui.
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CALENDAR_REDIRECT_URI=

# Configuracion publica del futuro proveedor de autenticacion.
EXPO_PUBLIC_AUTH_PROVIDER_URL=
EXPO_PUBLIC_AUTH_CLIENT_ID=

# Backend de sincronizacion en la nube (Project Settings > API en Supabase).
# La anon key es publica por diseno: el acceso real lo protege RLS en el backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
