{
  "name": "pawreminder",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run metro:kill --silent && expo start",
    "start:clear": "npm run metro:kill --silent && expo start --clear",
    "start:lan": "npm run metro:kill --silent && REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr en0 || ipconfig getifaddr en1) expo start --lan",
    "start:tunnel": "npm run metro:kill --silent && expo start --tunnel",
    "metro:kill": "lsof -ti:8081,8082 | xargs kill -9 2>/dev/null; sleep 1; true",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@tamagui/babel-plugin": "^2.7.4",
    "@tamagui/config": "^2.7.4",
    "@tamagui/metro-plugin": "^2.7.4",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.0",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.0",
    "jest-expo": "~54.0.17",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^1.31.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.5.1",
    "tamagui": "^2.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
